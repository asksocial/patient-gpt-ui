{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asksocial.example/schemas/pv-training/botulinum-toxin/ae-adr-master-taxonomy/2026.01.0",
  "title": "AskSocial AE/ADR master taxonomy record",
  "type": "object",
  "required": [
    "concept_id", "taxonomy_version", "meddra_pt", "normalized_label", "normalized_concept", "concept_group_id",
    "relationship_status", "related_concepts", "semantic_category", "semantic_categories", "category_system",
    "category_is_official_meddra_hierarchy", "source_reaction_occurrence_count", "source_case_count",
    "source_report_count", "associated_target_products", "associated_active_ingredients", "serious_case_count",
    "nonserious_case_count", "unknown_seriousness_case_count", "example_case_ids", "ranks", "review_status", "provenance"
  ],
  "properties": {
    "concept_id": { "type": "string", "minLength": 1 },
    "taxonomy_version": { "type": "string", "minLength": 1 },
    "meddra_pt": { "type": "string", "minLength": 1 },
    "normalized_label": { "type": "string", "minLength": 1 },
    "normalized_concept": { "type": "string", "minLength": 1 },
    "concept_group_id": { "type": "string", "minLength": 1 },
    "relationship_status": { "enum": ["algorithmic_candidate_pending_pv_review", "no_relationship_suggested"] },
    "related_concepts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["meddra_pt", "normalized_concept", "relationship_type", "confidence", "rationale", "review_status"],
        "properties": {
          "meddra_pt": { "type": "string" },
          "normalized_concept": { "type": "string" },
          "relationship_type": { "enum": ["equivalent_to", "closely_related_to"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "rationale": { "type": "string" },
          "review_status": { "const": "algorithmic_candidate_pending_pv_review" }
        },
        "additionalProperties": false
      }
    },
    "semantic_category": { "$ref": "#/$defs/semanticCategory" },
    "semantic_categories": { "type": "array", "items": { "$ref": "#/$defs/semanticCategory" }, "minItems": 1, "uniqueItems": true },
    "category_system": { "type": "string", "pattern": "^ASKSOCIAL_INTERNAL_" },
    "category_is_official_meddra_hierarchy": { "const": false },
    "source_reaction_occurrence_count": { "type": "integer", "minimum": 1 },
    "source_case_count": { "type": "integer", "minimum": 1 },
    "source_report_count": { "type": "integer", "minimum": 1 },
    "associated_target_products": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "associated_active_ingredients": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "serious_case_count": { "type": "integer", "minimum": 0 },
    "nonserious_case_count": { "type": "integer", "minimum": 0 },
    "unknown_seriousness_case_count": { "type": "integer", "minimum": 0 },
    "first_seen_date": { "type": "string", "format": "date" },
    "last_seen_date": { "type": "string", "format": "date" },
    "example_case_ids": { "type": "array", "items": { "type": "string" }, "minItems": 1, "maxItems": 5, "uniqueItems": true },
    "ranks": {
      "type": "object",
      "required": ["frequency", "seriousness", "product_breadth", "unique_cases"],
      "properties": {
        "frequency": { "type": "integer", "minimum": 1 },
        "seriousness": { "type": "integer", "minimum": 1 },
        "product_breadth": { "type": "integer", "minimum": 1 },
        "unique_cases": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "review_status": { "const": "draft_pending_pv_review" },
    "provenance": {
      "type": "object",
      "required": [
        "source", "source_corpus_snapshot", "source_normalized_records", "source_manifest_sha256",
        "source_normalized_records_sha256", "source_configuration_version", "source_product_registry_version",
        "source_mapping_version", "taxonomy_rules_version", "source_meddra_versions", "generated_at", "association_statement"
      ],
      "properties": {
        "source": { "const": "FDA_FAERS_OPENFDA_NORMALIZED_CORPUS" },
        "source_corpus_snapshot": { "type": "string" },
        "source_normalized_records": { "type": "string" },
        "source_manifest_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "source_normalized_records_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "source_configuration_version": { "type": "string" },
        "source_product_registry_version": { "type": "string" },
        "source_mapping_version": { "type": "string" },
        "taxonomy_rules_version": { "type": "string" },
        "source_meddra_versions": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "generated_at": { "type": "string", "format": "date-time" },
        "association_statement": { "type": "string", "pattern": "does not establish" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "semanticCategory": {
      "enum": [
        "neuromuscular", "ocular", "respiratory", "swallowing", "speech", "injection-site", "systemic",
        "allergic/hypersensitivity", "weakness/fatigue", "cosmetic/asymmetry", "pain", "gastrointestinal",
        "cardiovascular", "neurologic", "psychiatric", "other"
      ]
    }
  }
}
