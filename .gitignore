# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js (CRITICAL FIX)
.next
.next*
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (never commit secrets)
.env*
.env
.env.local
.env.*.local
!.env.example

# vercel
.vercel

# turbo
.turbo

# typescript
*.tsbuildinfo
next-env.d.ts

# local diagnostics and backups
/.backups/
/clean-output.json
/evidence-output.json
/ingestion-audit.json
/meltwater-author-audit.json
/meltwater-raw-fields.json
/ontology-audit*.json
/output.json
/unknown-ontology-*.json

# generated ingestion intermediates; retain only validated production corpora
/src/ingestion/curated/*.json
!/src/ingestion/curated/gene_therapy.json
/data/*
!/data/regen-aesthetics.csv
!/data/botulinum-toxin.csv
